# Obsidian 개인 설정 (볼트 공유 설정은 커밋하지 않음)
.obsidian/

# macOS
.DS_Store

# Node (구현 단계)
node_modules/
dist/
coverage/

# 환경 변수·비밀키 (Firebase 키 포함)
.env
.env.*
*-service-account*.json

# 프로토타입 빌드 산출물 (packages/proto/build.mjs로 생성)
prototype/
packages/proto/src/data.json

# 와이어프레임은 tools/wireframe.py 로 재생성 가능한 산출물
assets/wireframe/

# ComfyUI 생성 결과물 (원본은 ~/ComfyUI/output/)
assets/generated/
ui/assets/
ui/combat.html
ui/prologue.html

# 게임 페이지 생성 산출물 (tools/ui/build_game.mjs 로 재생성)
ui/game/engine.js
ui/game/data.js

# .NET 빌드 산출물 (ADR-029 — Godot/C# 이관)
bin/
obj/
*.user

# Godot
.godot/
game/.mono/

# 전투 화면(game/scenes/Combat.tscn)이 쓰는 아트는 ui/assets/ 로 건 파일 단위 심볼릭 링크다.
# 원본이 커밋 대상이 아니므로(위 ui/assets/) 링크와 Godot 임포트 메타도 제외한다 —
# 링크가 없는 환경에서는 CombatArt.Load() 가 폴백(이모지·단색 배경)으로 굴러간다.
game/assets/
